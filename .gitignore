.DS_Store
build
.deps/
vendor/*
lib/*
result
result-*

# Local-only helpers: run scripts, cluster experiments, scratch configs. Never
# part of the module; keep anything that is not implementation here.
.local/

# Doc-test output: generated artifacts are disposable, but keep the rendered
# .md and the UI screenshots that the docs embed. (report.html is published by
# CI to GitHub Pages, not committed.)
doctests/outputs/*
!doctests/outputs/*.md
!doctests/outputs/images/
