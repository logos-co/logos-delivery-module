    {
      "type": "timeseries",
      "title": "Seed: peers admitted (pure libp2p)",
      "description": "Members reach the seed as plain libp2p peers; it admits them against its --max-pure-libp2p-peers budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "sim-prom"
      },
      "targets": [
        {
