    {
      "type": "stat",
      "title": "Discovery coverage (median)",
      "description": "Median over nodes of the peers held in the service-discovery tables, as a share of the nodes currently up. It can pass 100% while ads of departed nodes are still cached.",
      "datasource": {
        "type": "prometheus",
        "uid": "sim-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile(0.5, max by (node) (cd_service_table_peers)) / scalar(count(up{job=\"sim-nodes\"} == 1)) * 100",
          "legendFormat": "",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "sim-prom"
          },
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
