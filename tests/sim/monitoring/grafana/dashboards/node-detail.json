    {
      "type": "timeseries",
      "title": "Connectivity, as the health monitor sees it",
      "description": "Connection status is computed from live gossipsub peers: zero relay peers reads as Disconnected, one or more as at least PartiallyConnected. The status itself is an event, not a metric, so these are its inputs rather than the verdict.",
      "datasource": {
        "type": "prometheus",
        "uid": "sim-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(libp2p_gossipsub_peers_per_topic_mesh{node=\"$node\", module=~\"delivery_module|in-process\"})",
          "legendFormat": "relay mesh peers",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "sim-prom"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(logos_delivery_pure_libp2p_peers{node=\"$node\", module=~\"delivery_module|in-process\"})",
          "legendFormat": "pure-libp2p peers",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "sim-prom"
          },
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(libp2p_pubsub_peers{node=\"$node\", module=~\"delivery_module|in-process\"})",
          "legendFormat": "pubsub peers",
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "sim-prom"
          },
          "instant": false,
          "range": true
        }
